{
  "name": "ba-memorial-lobby-electron",
  "version": "0.5.0",
  "description": "Blue Archive Memorial Lobby viewer (Electron + Pixi v8 + spine 4.2)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "vite build && python3 scripts/copy_web_assets.py",
    "build:linux": "vite build && electron-builder --linux",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "copy-assets": "python3 scripts/copy_assets.py",
    "lint:i18n": "python3 scripts/check_i18n.py",
    "lint:parity": "python3 scripts/check_asset_core_parity.py",
    "lint": "python3 scripts/check_i18n.py && python3 scripts/check_asset_core_parity.py",
    "test:tar": "node tests/tar_stream_test.mjs",
    "test:net": "node tests/fetch_retry_test.mjs",
    "test:unit": "node tests/tar_stream_test.mjs && node tests/fetch_retry_test.mjs",
    "dist": "vite build && electron-builder -mwl --publish always"
  },
  "build": {
    "appId": "com.ba.memorial-lobby",
    "productName": "BA Memorial Lobby",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "main.js",
      "wallpaper.js",
      "wallpaper-win.js",
      "wallpaper-x11.js",
      "wallpaper-proxy-preload.js",
      "tray.js",
      "preload.js",
      "package.json",
      "index.prod.html",
      "assets/ui/**",
      "assets/loading/**",
      "assets/clickfx/FX_TEX_*.png",
      "favicon.ico",
      "build/icon.png",
      "build/trayTemplate*.png"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "executableName": "ba-memorial-lobby",
      "desktop": {
        "Name": "BA Memorial Lobby"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "minimumSystemVersion": "11.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": {
    "name": "Augus1217",
    "email": "augus1217@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.119",
    "fflate": "^0.8.3",
    "koffi": "^3.3.3",
    "pixi.js": "^8.19.0",
    "tar": "^7.5.22"
  }
}
