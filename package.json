{
  "name": "ba-memorial-lobby-electron",
  "version": "0.1.0",
  "description": "Blue Archive Memorial Lobby viewer (Electron + Pixi v8 + spine 4.2)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "vite build && python3 scripts/copy_web_assets.py",
    "build:linux": "vite build && electron-builder --linux",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "copy-assets": "python3 scripts/copy_assets.py",
    "update-assets": "python3 scripts/build_assets.py",
    "dist": "vite build && electron-builder -mwl --publish always"
  },
  "build": {
    "appId": "com.ba.memorial-lobby",
    "productName": "BA Memorial Lobby",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "main.js",
      "preload.js",
      "package.json",
      "index.prod.html",
      "assets/data/ui_i18n.json",
      "assets/bgm/Theme_152_Title.ogg",
      "favicon.ico"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "executableName": "ba-memorial-lobby",
      "desktop": {
        "Name": "BA Memorial Lobby"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": {
    "name": "Augus1217",
    "email": "augus1217@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@esotericsoftware/spine-pixi-v8": "^4.2.119",
    "fflate": "^0.8.3",
    "pixi.js": "^8.19.0",
    "tar": "^7.5.22"
  }
}